generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 런타임(풀링) — Neon은 -pooler URL
  directUrl = env("DIRECT_URL") // 마이그레이션 전용(직결)
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique // 로그인 자격 — 소문자 정규화 저장
  loginId        String          @unique // 닉네임 — 2~16자, 한글/영문/숫자. 친구 추가 키·표시명
  passwordHash   String
  termsAgreedAt  DateTime // 회원가입 약관 동의 시각
  createdAt      DateTime        @default(now())
  jars           Jar[]
  draftEmotions  DraftEmotion[]
  friendships    Friendship[]    @relation("FriendshipOwner")
  friendOf       Friendship[]    @relation("FriendshipTarget")
  sentRequests   FriendRequest[] @relation("FriendRequestFrom")
  receivedRequests FriendRequest[] @relation("FriendRequestTo")
  jarLikes       JarLike[]
  notifications  Notification[]
}

// 감정 마스터 — 시드로 10종, id = sortOrder = 1~10 고정
model Emotion {
  id            Int            @id
  name          String         @unique
  colorHex      String // 프론트가 색 조합에 사용할 기준색
  sortOrder     Int
  isActive      Boolean        @default(true)
  jarEmotions   JarEmotion[]
  draftEmotions DraftEmotion[]
}

// 유리병 = 하루의 감정 기록
model Jar {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordDate DateTime     @db.Date // KST 기준 날짜 — 반드시 getKstToday()로만 생성
  createdAt  DateTime     @default(now())
  note       String?      @db.Text
  updatedAt  DateTime     @default(now()) // 감정/일기 내용이 바뀔 때만 서비스에서 갱신
  version    Int          @default(1)
  emotions   JarEmotion[]
  likes      JarLike[]

  @@unique([userId, recordDate]) // 하루 1병
}

// 유리병에 담긴 감정 — 순서 무관, 같은 감정은 count로 집계 (병당 합계 1~7)
model JarEmotion {
  jarId     String
  jar       Jar     @relation(fields: [jarId], references: [id], onDelete: Cascade)
  emotionId Int
  emotion   Emotion @relation(fields: [emotionId], references: [id])
  count     Int

  @@id([jarId, emotionId])
}

// 오늘 담는 중인 감정(드래프트) — 드래그 1회 = 1행, 되돌리기 = 마지막 행 삭제 (이벤트 로그)
// count는 파생값(감정별 행 수). 모든 조회·삭제는 반드시 (userId, recordDate=오늘 KST)로 필터할 것
model DraftEmotion {
  id         Int      @id @default(autoincrement()) // 삽입 순서 = 되돌리기 순서 (PG 시퀀스라 재사용 없음)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordDate DateTime @db.Date // KST 기준 — getKstToday()로만 생성
  emotionId  Int
  emotion    Emotion  @relation(fields: [emotionId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId, recordDate])
}

// 친구 요청 — 대기(pending) 상태만 행으로 존재. 수락 → Friendship 2행 생성 + 행 삭제, 거절 → 행 삭제.
// status 컬럼 없음: 이력이 필요 없어 "행이 있다 = 대기 중"이 가장 단순한 불변식
model FriendRequest {
  id         String   @id @default(cuid())
  fromUserId String
  from       User     @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  to         User     @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  notification Notification?

  @@unique([fromUserId, toUserId]) // 같은 상대에게 중복 요청 불가 (동시 요청 race의 최종 방어선)
  @@index([toUserId]) // 종 아이콘 — 받은 요청 조회
}

// 친구 — 수락 시 쌍방 2행, 유저당 최대 10명
model Friendship {
  userId    String
  user      User     @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendshipTarget", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, friendId])
}

// 취소해도 상태 행은 유지한다. 같은 관계에서 재좋아요가 알림을 다시 만들지 않게 하는 이력.
model JarLike {
  id           String        @id @default(cuid())
  jarId        String
  jar          Jar           @relation(fields: [jarId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  notification Notification?

  @@unique([jarId, userId])
  @@index([jarId, isActive])
  @@index([userId, jarId])
}

enum NotificationType {
  FRIEND_REQUEST
  JAR_LIKED
}

// 유형별 대상은 정확히 하나만 존재해야 한다 (migration의 CHECK 제약).
model Notification {
  id              String           @id @default(cuid())
  recipientId     String
  recipient       User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type            NotificationType
  jarLikeId       String?          @unique
  jarLike         JarLike?         @relation(fields: [jarLikeId], references: [id], onDelete: Cascade)
  friendRequestId String?          @unique
  friendRequest   FriendRequest?   @relation(fields: [friendRequestId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  readAt          DateTime?

  @@index([recipientId, createdAt, id])
  @@index([recipientId, type, createdAt, id])
  @@index([recipientId, readAt])
}
